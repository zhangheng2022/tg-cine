{
  "name": "tg-cine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "probe": "node scripts/probe.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "probe:direct": "node --env-file=.env scripts/probe-direct.mjs",
    "speed": "node --env-file=.env scripts/telegram-speed.mjs",
    "play": "node --env-file=.env scripts/telegram-speed.mjs --play",
    "play:native": "node --env-file=.env scripts/telegram-speed.mjs --play --native",
    "verify:play": "node --env-file=.env scripts/telegram-speed.mjs --play --check-recovery"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "teleproto": "1.230.0",
    "undici": "7.29.1"
  },
  "version": "0.1.0",
  "description": "Personal movie and TV player powered by Telegram — local streaming prototype",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangheng2022/tg-cine.git"
  }
}
